{
  "name": "axton-workspace",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/native",
    "packages/backend/server",
    "packages/frontend/client-js",
    "packages/backend/postgres",
    "packages/cli"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "bash scripts/test.sh",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write \"packages/frontend/client-js/**/*.mts\" \"packages/backend/server/**/*.mts\" \"packages/backend/postgres/**/*.mts\""
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.0",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.23.0",
    "prettier": "^3.6.0",
    "typescript": "5.8.3"
  }
}
