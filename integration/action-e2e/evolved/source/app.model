model Todo {
 id String
 title String
 note String?
 @@id(id)
 @@version(2)
}

@version(2) mutation AddTodo(todo Todo.create)
@version(2) mutation UpdateTodo(todo Todo.update<title>)
mutation DeleteTodo(todo Todo.delete)
mutation SendEmail(to String, subject String, body String) { messageId String }
@version(3) query SearchTodos(query String?) { todos Todo[] first Todo? count Int labels String[] hint String? }
@version(2) mutation RetitleTodos(query String, title String) { todos Todo[] first Todo? }
