// Transactional Mutation enqueue: an application transaction reads a local
// Composition and queues PublishEntry built from it. Rename carries scalars
// only.
model Composition {
 id UUID
 title String
 body String
 @@id(id)
}
mutation PublishEntry(entry Entry.create, composition UUID) { published Entry }
mutation Rename(id UUID, title String)

// Fresh direct read; store mode is a call option, never a business argument.
query ReadEntry(id UUID) { entry Entry? }
