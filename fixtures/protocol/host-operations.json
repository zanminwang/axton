{
  "comment": "One canonical request and one response per variant for every host operation. Shared by crates/server/tests/host_contract.rs (Rust types) and integration/persistence/server/host-contract.test.mjs (TypeScript host). The examples describe a backend with one model Task {id, title} and one mutation edit v1 with an update slot named task.",
  "operations": [
    {
      "op": "claim",
      "request": {"op": "claim", "owner": "alice", "clientId": "client-1"},
      "responses": [
        {"variant": "claimed", "value": {"clientId": "client-1", "owner": "alice", "sequence": 2, "receipt": "{\"batchSequence\":2,\"clientId\":\"client-1\",\"records\":[{\"identity\":{\"id\":\"t-1\"},\"model\":\"Task\",\"stamp\":4,\"state\":{\"title\":\"typed\"}}],\"rejections\":[]}"}},
        {"variant": "unused", "value": {"clientId": "client-1", "owner": "alice", "sequence": 0, "receipt": null}}
      ]
    },
    {
      "op": "saveReceipt",
      "request": {"op": "saveReceipt", "owner": "alice", "clientId": "client-1", "sequence": 3, "receipt": "{\"batchSequence\":3,\"clientId\":\"client-1\",\"records\":[{\"identity\":{\"id\":\"t-1\"},\"model\":\"Task\",\"stamp\":5,\"state\":{\"title\":\"typed\"}}],\"rejections\":[]}"},
      "responses": [{"variant": "acknowledged", "value": null}]
    },
    {
      "op": "claimCall",
      "request": {"op": "claimCall", "owner": "alice", "callId": "call-1", "request": "{\"name\":\"edit\",\"version\":1}"},
      "responses": [
        {"variant": "fresh", "value": {"fresh": true, "request": "{\"name\":\"edit\",\"version\":1}", "response": null}},
        {"variant": "replayed", "value": {"fresh": false, "request": "{\"name\":\"edit\",\"version\":1}", "response": "{\"status\":\"succeeded\"}"}}
      ]
    },
    {
      "op": "saveCall",
      "request": {"op": "saveCall", "owner": "alice", "callId": "call-1", "response": "{\"status\":\"succeeded\"}"},
      "responses": [{"variant": "acknowledged", "value": null}]
    },
    {
      "op": "head",
      "request": {"op": "head", "channel": "shared"},
      "responses": [
        {"variant": "cursor", "value": 6},
        {"variant": "empty", "value": 0}
      ]
    },
    {
      "op": "scan",
      "request": {"op": "scan", "channel": "shared", "after": 4, "limit": 50},
      "responses": [
        {"variant": "rows", "value": [{"channel": "shared", "cursor": 5, "model": "Task", "identity": {"id": "t-1"}, "identityKey": "{\"id\":\"t-1\"}", "stamp": 4}]},
        {"variant": "none", "value": []}
      ]
    },
    {
      "op": "savepoint",
      "request": {"op": "savepoint", "ordinal": 1},
      "responses": [{"variant": "acknowledged", "value": null}]
    },
    {
      "op": "rollback",
      "request": {"op": "rollback", "ordinal": 1},
      "responses": [{"variant": "acknowledged", "value": null}]
    },
    {
      "op": "release",
      "request": {"op": "release", "ordinal": 1},
      "responses": [{"variant": "acknowledged", "value": null}]
    },
    {
      "op": "handle",
      "request": {"op": "handle", "name": "edit", "version": 1, "arguments": {"task": {"identity": {"id": "t-1"}, "patch": {"title": "typed"}}}, "owner": "alice", "ordinal": 1},
      "responses": [
        {"variant": "settled", "value": {"changes": [{"model": "Task", "identity": {"id": "t-1"}}, {"model": "Task", "identity": {"id": "t-2"}}], "publications": [{"channel": "shared"}, {"channel": "other", "records": [{"model": "Task", "identity": {"id": "t-1"}}]}]}},
        {"variant": "quiet", "value": {"changes": [], "publications": []}},
        {"variant": "rejected", "value": {"rejection": "task.refused"}},
        {"variant": "failed", "value": {"error": "TypeError: cannot read title of undefined"}}
      ]
    },
    {
      "op": "handleAction",
      "request": {"op": "handleAction", "name": "Send", "version": 1, "arguments": {}, "owner": "alice", "callId": "01890f47-1234-7123-8123-123456789abc", "ordinal": 1},
      "responses": [
        {"variant": "settled", "value": {"outputs": {"message": "sent"}, "changes": [], "publications": []}},
        {"variant": "rejected", "value": {"rejection": "send.refused"}},
        {"variant": "failed", "value": {"error": "handler failure"}}
      ]
    },
    {
      "op": "load",
      "request": {"op": "load", "model": "Task", "version": 1, "identities": [{"id": "t-1"}, {"id": "t-2"}], "owner": "alice"},
      "responses": [
        {"variant": "rows", "value": [{"id": "t-1", "title": "typed"}, null]},
        {"variant": "refused", "value": {"rejection": "task.forbidden"}},
        {"variant": "failed", "value": {"error": "connection reset while reading tasks"}}
      ]
    },
    {
      "op": "advanceStamp",
      "request": {"op": "advanceStamp", "model": "Task", "identityKey": "{\"id\":\"t-1\"}"},
      "responses": [{"variant": "stamped", "value": 4}]
    },
    {
      "op": "ensureStamp",
      "request": {"op": "ensureStamp", "model": "Task", "identityKey": "{\"id\":\"t-2\"}"},
      "responses": [{"variant": "stamped", "value": 1}]
    },
    {
      "op": "publish",
      "request": {"op": "publish", "channel": "shared", "model": "Task", "identity": {"id": "t-1"}, "identityKey": "{\"id\":\"t-1\"}", "stamp": 4},
      "responses": [{"variant": "published", "value": {"cursor": 6, "stamp": 4}}]
    },
    {
      "op": "lockRecord",
      "request": {"op": "lockRecord", "model": "Task", "identityKey": "{\"id\":\"t-1\"}"},
      "responses": [
        {"variant": "locked", "value": 4},
        {"variant": "absent", "value": null}
      ]
    },
    {
      "op": "memberships",
      "request": {"op": "memberships", "model": "Task", "identityKey": "{\"id\":\"t-1\"}"},
      "responses": [
        {"variant": "members", "value": ["other", "shared"]},
        {"variant": "none", "value": []}
      ]
    },
    {
      "op": "setMembership",
      "request": {"op": "setMembership", "channel": "shared", "model": "Task", "identityKey": "{\"id\":\"t-1\"}", "present": true},
      "responses": [{"variant": "acknowledged", "value": null}]
    }
  ]
}
